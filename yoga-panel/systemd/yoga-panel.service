[Unit]
Description=Yoga Book lower-screen keyboard and touchpad
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStartPre=/usr/bin/python3 %h/.local/share/yoga-panel/ensure-runtime.py
ExecStartPre=/usr/bin/python3 %h/.local/share/yoga-panel/ensure-plugin.py
ExecStart=/usr/bin/quickshell -p %h/.local/share/yoga-panel --no-duplicate
TimeoutStartSec=90
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
