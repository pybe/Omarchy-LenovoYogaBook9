# Install to /etc/libinput/local-overrides.quirks (root-owned).
# libinput reads ONLY that path -- a copy under ~/.config/libinput/ is
# silently ignored, which looks identical to the quirk not working.
# Lenovo Yoga Book 9 13IRU8 (82YQ)

[Yoga Book 9 Emulated Touchpad]
MatchName=*Emulated Touchpad*
MatchUdevType=touchpad
# The firmware declares this a clickpad while also advertising a physical
# right button, which libinput reports as a kernel bug and which makes
# right-click unreliable. Removing the bogus button leaves clickfinger
# behaviour to provide right-click.
#
# The attribute is AttrEventCode with a "-" prefix. AttrEventCodeDisable is
# NOT a libinput attribute -- it appears nowhere in the shipped quirks, and an
# unrecognised attribute makes the section be ignored with no error anywhere
# the user will see it. Precedent: /usr/share/libinput/30-vendor-hantick.quirks
AttrEventCode=-BTN_RIGHT
