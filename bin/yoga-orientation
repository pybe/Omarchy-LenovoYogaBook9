#!/usr/bin/env python3
"""Print orientation live. Ctrl-C to stop.

Run it, then move the machine into each position you care about and note what
it reports. Auto-rotation can only be as good as what this shows.
"""
import gi, time, sys
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
bus.call_sync("net.hadess.SensorProxy", "/net/hadess/SensorProxy",
              "net.hadess.SensorProxy", "ClaimAccelerometer", None, None,
              Gio.DBusCallFlags.NONE, -1, None)

def prop(name):
    v = bus.call_sync("net.hadess.SensorProxy", "/net/hadess/SensorProxy",
        "org.freedesktop.DBus.Properties", "Get",
        GLib.Variant("(ss)", ("net.hadess.SensorProxy", name)),
        None, Gio.DBusCallFlags.NONE, -1, None)
    return v.unpack()[0]

def iio_device(want):
    """Resolve an IIO device by its name attribute.

    Numbering is probe-order dependent -- this machine enumerates
    gyro_3d, als, accel_3d, gyro_3d, hinge as devices 0-4, and a hardcoded
    index silently reads the wrong sensor if that shuffles across a kernel or
    firmware update. Reading gyro_3d instead of accel_3d is exactly the sort of
    mistake that looks like working data.
    """
    import glob
    for path in sorted(glob.glob("/sys/bus/iio/devices/iio:device*")):
        try:
            with open(f"{path}/name") as f:
                if f.read().strip() == want:
                    return path
        except OSError:
            continue
    return None


ACCEL = iio_device("accel_3d")
HINGE = iio_device("hinge")


def raw(axis):
    if ACCEL is None:
        return None
    try:
        with open(f"{ACCEL}/in_accel_{axis}_raw") as f:
            return int(f.read())
    except OSError:
        return None

LOG = "/tmp/yoga-orientation.log"
log = open(LOG, "w", buffering=1)
print(f"Move the machine into each position you use. Ctrl-C when done.")
print(f"Recording to {LOG}\n")
print(f"{'orientation':<14}{'tilt':<12}{'accel x/y/z':<28}{'hinge':<8}")
try:
    while True:
        if HINGE is None:
            hinge = "absent"
        else:
            try:
                with open(f"{HINGE}/in_angl0_raw") as f:
                    hinge = f.read().strip()
            except OSError:
                hinge = "unreadable"
        vals = [raw(a) for a in ("x", "y", "z")]
        axes = ("accel_3d not found" if None in vals
                else f"{vals[0]:>7} {vals[1]:>8} {vals[2]:>8}")
        line = (f"{prop('AccelerometerOrientation'):<14}"
                f"{prop('AccelerometerTilt'):<12}{axes:<28}{hinge:<8}")
        print(line, flush=True)
        log.write(line + "\n")
        time.sleep(1)
except KeyboardInterrupt:
    pass
finally:
    bus.call_sync("net.hadess.SensorProxy", "/net/hadess/SensorProxy",
                  "net.hadess.SensorProxy", "ReleaseAccelerometer", None, None,
                  Gio.DBusCallFlags.NONE, -1, None)
    log.close()
    print(f"\nstopped — recorded to {LOG}")
