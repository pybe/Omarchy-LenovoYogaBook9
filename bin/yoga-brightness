#!/bin/bash

# Drive both internal panels of the Yoga Book 9 from one brightness command.
#
# omarchy-hw-display walks a fixed preference list and returns intel_backlight
# (eDP-1), so the stock brightness keys never see the second panel's backlight
# and eDP-2 stays wherever it was last left. This runs the stock command for
# eDP-1 plus the OSD, then mirrors the resulting level onto eDP-2.

PRIMARY=intel_backlight
SECONDARY=card1-eDP-2-backlight

omarchy-brightness-display "$@"

# No brightness argument means the stock command only printed a value.
(($# > 0)) || exit 0
case "${*: -1}" in
--no-osd | off | on) exit 0 ;;
esac

# An external DDC monitor being targeted must not drag eDP-2 along with it.
#
# Honour --monitor if given, since this wrapper stands in for a command that
# supports it; otherwise ask which monitor has focus.
target_monitor=""
prev=""
for arg in "$@"; do
  [[ $prev == "--monitor" ]] && { target_monitor="$arg"; break; }
  prev="$arg"
done
[[ -n $target_monitor ]] || target_monitor="$(omarchy-hyprland-monitor-focused 2>/dev/null || true)"

# An EMPTY result means we could not ask -- hyprctl not answering yet, or this
# was invoked from a systemd unit or a TTY. Treat that as internal and mirror
# anyway: the autostart login sync runs in exactly that situation, and bailing
# out here silently made it a no-op, leaving eDP-2 at whatever systemd-backlight
# restored. Only skip when we positively know the target is external.
if [[ -n $target_monitor && ! $target_monitor =~ ^(eDP|LVDS|DSI)- ]]; then
  exit 0
fi

pct="$(brightnessctl -d "$PRIMARY" -m 2>/dev/null | awk -F, '{ gsub("%", "", $4); print $4 }')"
[[ -n $pct ]] || exit 0
brightnessctl -d "$SECONDARY" set "$pct%" >/dev/null
