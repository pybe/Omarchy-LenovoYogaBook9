#!/usr/bin/env python3
"""Switch display modes from the accelerometer.

Three of the four usage modes are distinguishable by orientation alone:

    normal     -> stand      (stacked landscape)
    left-up    -> book       (two portrait screens)
    right-up   -> book-flip  (book, turned the other way)
    bottom-up  -> present    (folded in half, upper panel facing away)

Four physical positions, four orientations, one mapping each. Present is the
machine folded in half so one screen faces each person -- a distinct physical
state the accelerometer reports as bottom-up, not a display preference.

The hinge sensor would have distinguished a genuine fold from the machine
merely being tilted, but it reads 0 permanently on this hardware. A stability
delay stands in for it: an orientation must persist before it is acted on.
"""

import json
import signal
import subprocess
import sys
import time
from pathlib import Path

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

POLL_SECONDS = 1
STABLE_READINGS = 4   # ~4s of agreement before acting

ORIENTATION_TO_MODE = {
    "normal": "stand",
    "left-up": "book",
    "right-up": "book-flip",
    "bottom-up": "present",
}


# Expected layout per mode: (x, y, transform) for each panel. Present is
# identified by eDP-1 mirroring rather than by position, since a mirroring
# output's coordinates are not meaningful.
LAYOUTS = {
    "stand":     {"eDP-1": (0, 0, 2),   "eDP-2": (0, 900, 0)},
    "book":      {"eDP-1": (900, 0, 3), "eDP-2": (0, 0, 1)},
    "book-flip": {"eDP-1": (0, 0, 1),   "eDP-2": (900, 0, 3)},
}


def current_mode():
    """Infer the mode from the live layout, not from a recorded value.

    hyprctl eval changes are not persisted, so any Hyprland config reload --
    an edit to ~/.config/hypr/*.lua, a theme change, or the `hyprctl reload`
    the docs themselves suggest -- silently reverts both panels to the stand
    layout in monitors.lua. A recorded mode would still claim "book", and the
    daemon would decline to correct it because it believed it already had.
    """
    try:
        out = subprocess.run(["hyprctl", "monitors", "all", "-j"],
                             capture_output=True, text=True, timeout=10).stdout
        monitors = {m["name"]: m for m in json.loads(out)}
    except (OSError, subprocess.SubprocessError, ValueError, KeyError):
        return None

    if monitors.get("eDP-1", {}).get("mirrorOf", "none") != "none":
        return "present"

    for name, expected in LAYOUTS.items():
        if all(
            (monitors.get(panel, {}).get("x"),
             monitors.get(panel, {}).get("y"),
             monitors.get(panel, {}).get("transform")) == want
            for panel, want in expected.items()
        ):
            return name
    return None


def apply_mode(mode):
    try:
        result = subprocess.run(["yoga-mode", mode],
                                capture_output=True, text=True, timeout=15)
        if result.returncode != 0:
            print(f"yoga-mode {mode} failed: {result.stderr.strip()}",
                  file=sys.stderr, flush=True)
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"could not run yoga-mode {mode}: {exc}",
              file=sys.stderr, flush=True)


class Accelerometer:
    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        for _ in range(30):
            try:
                self._claim()
                return
            except GLib.Error:
                time.sleep(2)
        raise SystemExit("iio-sensor-proxy did not appear on the bus")

    def _claim(self):
        self.bus.call_sync(
            "net.hadess.SensorProxy", "/net/hadess/SensorProxy",
            "net.hadess.SensorProxy", "ClaimAccelerometer", None, None,
            Gio.DBusCallFlags.NONE, -1, None,
        )

    def release(self):
        try:
            self.bus.call_sync(
                "net.hadess.SensorProxy", "/net/hadess/SensorProxy",
                "net.hadess.SensorProxy", "ReleaseAccelerometer", None, None,
                Gio.DBusCallFlags.NONE, -1, None,
            )
        except GLib.Error:
            pass

    def orientation(self):
        value = self.bus.call_sync(
            "net.hadess.SensorProxy", "/net/hadess/SensorProxy",
            "org.freedesktop.DBus.Properties", "Get",
            GLib.Variant("(ss)", ("net.hadess.SensorProxy",
                                  "AccelerometerOrientation")),
            None, Gio.DBusCallFlags.NONE, -1, None,
        )
        return value.unpack()[0]


def main():
    accel = Accelerometer()

    def shutdown(*_):
        accel.release()
        sys.exit(0)

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    pending = None
    count = 0

    while True:
        time.sleep(POLL_SECONDS)

        try:
            orientation = accel.orientation()
        except GLib.Error:
            try:
                accel._claim()
            except GLib.Error:
                pass
            continue

        target = ORIENTATION_TO_MODE.get(orientation)
        if target is None:
            pending, count = None, 0
            continue

        if target == pending:
            count += 1
        else:
            pending, count = target, 1

        # Act once the orientation has settled, and keep acting while it stays
        # settled but the layout does not match. `==` here meant a single failed
        # switch -- yoga-mode missing, hyprctl not up yet just after login --
        # was never retried, because count then ran past the value forever.
        if count >= STABLE_READINGS and target != current_mode():
            apply_mode(target)


if __name__ == "__main__":
    main()
