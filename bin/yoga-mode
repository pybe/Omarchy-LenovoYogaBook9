#!/bin/bash

# Switch the Yoga Book 9's two panels between physical usage modes.
#
# eDP-1 is the upper panel and is mounted 180 degrees out, so every transform
# for it is the one eDP-2 needs plus 2 (mod 4). That holds in every mode and is
# why the numbers below look asymmetric.
#
# hyprctl keyword does not work under Omarchy's Lua config parser -- these go
# through hyprctl eval instead.
#
# Every mode follows the same order: park eDP-2 far away, place eDP-1, then
# place eDP-2. Moving one panel and then the other otherwise leaves a moment
# where both occupy the same space, and Hyprland raises its on-screen
# "Monitor ... overlaps" banner. A previous version parked eDP-2 but then
# placed it FIRST in book and present modes, which reintroduced the very
# overlap the parking existed to avoid.
#
# Every non-mirroring mode sets mirror = "none" explicitly. Set once it
# persists, and because `hyprctl monitors` HIDES mirrored outputs the panel
# then appears to have vanished rather than merely being mirrored -- use
# `hyprctl monitors all` when a monitor seems to disappear.

set -u

MODE_FILE="${XDG_RUNTIME_DIR:-/tmp}/yoga-mode"
SHELL_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
MODE="2880x1800@60"
PARK="10000x0"

# Propagate failure: a mode that did not apply must not be recorded as current,
# or the menu ticks the wrong row, `cycle` steps from a false state, and
# yoga-autorotate believes the layout already matches.
apply() {
  local out
  if ! out="$(hyprctl eval "$1" 2>&1)" || [[ $out != ok* ]]; then
    echo "hyprctl eval failed: ${out:-no output}" >&2
    return 1
  fi
}

# Tablet and stand-on-its-back leave the lower panel facing away or down, so it
# goes dark and deaf. Every other mode turns it back on: `disabled` persists
# once set, exactly like `mirror`.
lower_input() {
  local dev
  for dev in touchscreen stylus; do
    # hl.device replaces the device's whole rule: without output it forgets the
    # eDP-2 mapping from input.lua, and touches stop reaching the lower panel.
    apply "hl.device({ name = \"ingenic-gadget-serial-and-keyboard-$dev-bottom\", output = \"eDP-2\", enabled = $1 })" || return 1
  done
}

park() {
  # Only when coming back from tablet. hl.device replaces a device's whole
  # rule, so re-applying it on every mode switch would silently wipe anything
  # else input.lua configures for these two devices.
  if lower_disabled; then lower_input true || return 1; fi
  apply "hl.monitor({ output = \"eDP-2\", mode = \"$MODE\", position = \"$PARK\", scale = 2, transform = 0, mirror = \"none\", disabled = false })"
}

mode_stand() {
  park &&
  apply "hl.monitor({ output = \"eDP-1\", mode = \"$MODE\", position = \"0x0\",   scale = 2, transform = 2, mirror = \"none\" })" &&
  apply "hl.monitor({ output = \"eDP-2\", mode = \"$MODE\", position = \"0x900\", scale = 2, transform = 0, mirror = \"none\" })"
}

# Book: machine turned 90 degrees, two portrait screens side by side.
# 900x1440 logical each once rotated, so the right-hand panel starts at x=900.
mode_book() {
  park &&
  apply "hl.monitor({ output = \"eDP-1\", mode = \"$MODE\", position = \"900x0\", scale = 2, transform = 3, mirror = \"none\" })" &&
  apply "hl.monitor({ output = \"eDP-2\", mode = \"$MODE\", position = \"0x0\",   scale = 2, transform = 1, mirror = \"none\" })"
}

# Book turned the other way. Which direction you rotate depends on where the
# ports and cables are, so both exist. Each panel gains 180 degrees relative to
# mode_book, and the two swap sides.
mode_book_flip() {
  park &&
  apply "hl.monitor({ output = \"eDP-1\", mode = \"$MODE\", position = \"0x0\",   scale = 2, transform = 1, mirror = \"none\" })" &&
  apply "hl.monitor({ output = \"eDP-2\", mode = \"$MODE\", position = \"900x0\", scale = 2, transform = 3, mirror = \"none\" })"
}

# Present: machine folded in half, upper panel facing the person opposite. It
# mirrors the lower panel at transform 0 -- upside down to you, correct way up
# to them. A mirroring output ignores its position visually but Hyprland still
# counts it in the layout, so it must not share coordinates with eDP-2.
mode_present() {
  park &&
  apply "hl.monitor({ output = \"eDP-1\", mode = \"$MODE\", position = \"0x900\", scale = 2, transform = 0, mirror = \"eDP-2\" })" &&
  apply "hl.monitor({ output = \"eDP-2\", mode = \"$MODE\", position = \"0x0\",   scale = 2, transform = 0, mirror = \"none\" })"
}

# Workspace id shown on eDP-1, and ids of workspaces on eDP-2 holding windows.
active_upper() {
  hyprctl monitors -j | python3 -c "import json,sys
print(next((m['activeWorkspace']['id'] for m in json.load(sys.stdin) if m['name']=='eDP-1'),''))"
}
lower_disabled() {
  hyprctl monitors all -j | python3 -c "import json,sys
sys.exit(0 if any(m['name']=='eDP-2' and m['disabled'] for m in json.load(sys.stdin)) else 1)"
}
focus_workspace() {
  [[ -n $1 ]] && apply "hl.dispatch(hl.dsp.focus({ workspace = \"$1\" }))"
}

# Disabling eDP-2 hands its workspace to eDP-1 and makes it the visible one, so
# the tablet would open on the lower panel's (usually empty) desktop. Enabling
# it again sends every workspace back where it came from, and whatever was
# opened or used in tablet mode lands on the keyboard panel. Keep what the
# upper panel showed, and gather windowed workspaces onto it on the way out.
keep_upper_after() {
  local keep id
  keep="$(active_upper)"
  "$@" || return 1
  for id in $(hyprctl workspaces -j | python3 -c "import json,sys
print(' '.join(str(w['id']) for w in json.load(sys.stdin) if w['monitor']=='eDP-2' and w['windows'] and w['id']>0))"); do
    apply "hl.dispatch(hl.dsp.workspace.move({ workspace = \"$id\", monitor = \"eDP-1\" }))"
  done
  focus_workspace "$keep"
}

# Tablet: folded 360 degrees, only the upper panel on. It rotates with the
# machine; $1 is the eDP-1 transform for how it is held.
mode_tablet() {
  apply "hl.monitor({ output = \"eDP-1\", mode = \"$MODE\", position = \"0x0\", scale = 2, transform = $1, mirror = \"none\" })" &&
  apply "hl.monitor({ output = \"eDP-2\", disabled = true })" &&
  lower_input false
}
tablet_normal()    { mode_tablet 2; }
tablet_upside()    { mode_tablet 0; }
tablet_left()      { mode_tablet 3; }
tablet_right()     { mode_tablet 1; }

current() { cat "$MODE_FILE" 2>/dev/null || echo stand; }

bar_position() {
  python3 -c "import json,sys
try: print(json.load(open(sys.argv[1]))['bar']['position'])
except Exception: pass" "$SHELL_JSON" 2>/dev/null
}

# Changing the layout can make the shell rewrite its own config and relocate
# the bar. Put the user's choice back afterwards. Written atomically: this
# truncates a live config the user depends on, and a mode switch during logout
# is exactly when it could be interrupted.
restore_bar_position() {
  local want="$1" have
  [[ -n $want ]] || return 0
  sleep 1
  have="$(bar_position)"
  [[ $have == "$want" ]] && return 0
  python3 -c "import json,os,sys,tempfile
p,want=sys.argv[1],sys.argv[2]
d=json.load(open(p)); d['bar']['position']=want
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(p))
with os.fdopen(fd,'w') as f: f.write(json.dumps(d,indent=2)+'\n')
os.replace(tmp,p)" "$SHELL_JSON" "$want" &&
    echo "restored bar position: $have -> $want"
}

notify() {
  command -v omarchy-notification-send >/dev/null &&
    omarchy-notification-send -u low "Display mode: $1"
  echo "display mode: $1"
}

# Apply a mode, and only record and announce it if it actually took.
switch_to() {
  local name="$1" fn="$2" label="${3:-$1}" wanted_bar wrap=()
  wanted_bar="$(bar_position)"
  # Entering or leaving tablet moves workspaces between panels; see keep_upper_after.
  if [[ $name == tablet* ]] || lower_disabled; then wrap=(keep_upper_after); fi
  if ! "${wrap[@]}" "$fn"; then
    echo "failed to switch to $name; layout unchanged" >&2
    return 1
  fi
  echo "$name" > "$MODE_FILE"
  restore_bar_position "$wanted_bar"
  notify "$label"
}

case "${1:-cycle}" in
stand | laptop)    switch_to stand     mode_stand ;;
book)              switch_to book      mode_book ;;
book-flip | book2) switch_to book-flip mode_book_flip "book (other way)" ;;
present | tent)    switch_to present   mode_present ;;
tablet)            switch_to tablet    tablet_normal ;;
tablet-upside)     switch_to tablet-upside tablet_upside tablet ;;
tablet-left)       switch_to tablet-left   tablet_left   tablet ;;
tablet-right)      switch_to tablet-right  tablet_right  tablet ;;
cycle)
  case "$(current)" in
  stand)     exec "$0" book ;;
  book)      exec "$0" book-flip ;;
  book-flip) exec "$0" present ;;
  *)         exec "$0" stand ;;
  esac
  ;;
status) current ;;
*)
  echo "usage: ${0##*/} [stand|book|book-flip|present|tablet[-upside|-left|-right]|cycle|status]" >&2
  exit 1
  ;;
esac
