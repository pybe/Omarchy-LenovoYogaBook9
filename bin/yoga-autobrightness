#!/usr/bin/env python3
"""Ambient-light brightness for the Lenovo Yoga Book 9's two internal panels.

Why this is Python rather than a shell script, having tried both:

* A light claim is bound to the D-Bus *connection* that made it. Claiming with
  `busctl call ClaimLight` and then polling the property cannot work: busctl
  exits, the claim dies, the sensor powers down, and LightLevel returns 0
  forever while HasAmbientLight still reports true. That looks exactly like
  broken hardware. This holds one connection open for its lifetime.

* `monitor-sensor` does hold a claim, but its output does not survive a pipe.
  Measured on this machine: redirected straight to a file it writes ~17 lines
  in 12s progressively; piped to `cat` the same lines arrive in one burst when
  it exits; piped into a `while read` loop only the two startup lines ever
  arrive. `stdbuf -oL` does not change that and a pty via `script` was no
  better. Whatever the mechanism, a shell read loop cannot be driven from it.

Both backlights are set directly rather than via omarchy-brightness-display,
which resolves its target from the focused monitor -- meaningless for a daemon.
"""

import os
import signal
import subprocess
import sys
import time
from pathlib import Path

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

CONFIG_PATH = Path(
    os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")
) / "yoga-autobrightness.conf"

PRIMARY = "intel_backlight"
SECONDARY = "card1-eDP-2-backlight"

POLL_SECONDS = 2
MIN_PCT = 10
MAX_PCT = 100
STEP_THRESHOLD = 3        # ignore smaller changes so it does not hunt
MANUAL_TOLERANCE = 2      # rounding slack when checking for a manual change
MANUAL_PAUSE_SECONDS = 600

# Logarithmic, because perceived brightness tracks log illuminance, and fitted
# to the range a room actually spans rather than the sensor's full scale. This
# panel reads ~70 lux under normal indoor light and ~30 with the sensor
# covered; a curve stretched to daylight puts those a few percent apart and the
# feature goes unnoticed -- which is worse than failing, because it looks
# broken. Anchored at 30 lux -> 20% and 300 lux -> 85%.
CURVE_OFFSET = -78.0
CURVE_SCALE = 65.8


def show_osd_enabled():
    """Whether to raise the on-screen slider on an automatic change.

    Read fresh each time rather than cached at startup, so toggling it takes
    effect immediately instead of needing the service restarted. Defaults to
    on: a brightness change with no visible cause reads as a glitch.
    """
    try:
        for line in CONFIG_PATH.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            key, _, value = line.partition("=")
            if key.strip() == "show_osd":
                return value.strip().lower() in ("1", "true", "yes", "on")
    except OSError:
        pass
    return True


def lux_to_pct(lux):
    import math

    pct = CURVE_OFFSET + CURVE_SCALE * math.log10(lux + 1)
    return int(max(MIN_PCT, min(MAX_PCT, pct)))


def current_pct():
    try:
        out = subprocess.run(
            ["brightnessctl", "-d", PRIMARY, "-m"],
            capture_output=True, text=True, timeout=5,
        ).stdout
        return int(out.split(",")[3].rstrip("%"))
    except Exception:
        return None


def set_pct(pct):
    for device in (PRIMARY, SECONDARY):
        subprocess.run(
            ["brightnessctl", "-d", device, "set", f"{pct}%"],
            capture_output=True, timeout=5,
        )
    # brightnessctl writes sysfs directly and does not raise Omarchy's OSD --
    # that comes from omarchy-osd, called explicitly by the brightness keys.
    # Without it an automatic change is invisible and reads as a glitch.
    #
    # Guarded: omarchy-osd resolves only because /usr/share/omarchy/bin is on
    # the user manager's PATH. Unguarded, its absence raises FileNotFoundError
    # out of here and kills the daemon on the first adjustment -- which looks
    # like "auto-brightness works for a few seconds after login, then stops".
    if not show_osd_enabled():
        return
    try:
        subprocess.Popen(
            ["omarchy-osd", "-i", "brightness", "-p", str(pct)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


class Sensor:
    """Holds the light claim for as long as this object lives."""

    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.claimed = False
        # iio-sensor-proxy is a system service; a user unit cannot order
        # against it, so at login it may not be on the bus yet. Retry rather
        # than die and rely on the restart loop to paper over it.
        for attempt in range(30):
            try:
                self.claim()
                return
            except GLib.Error:
                time.sleep(2)
        raise SystemExit("iio-sensor-proxy did not appear on the bus")

    def claim(self):
        self.bus.call_sync(
            "net.hadess.SensorProxy", "/net/hadess/SensorProxy",
            "net.hadess.SensorProxy", "ClaimLight", None, None,
            Gio.DBusCallFlags.NONE, -1, None,
        )
        self.claimed = True

    def release(self):
        if not self.claimed:
            return
        try:
            self.bus.call_sync(
                "net.hadess.SensorProxy", "/net/hadess/SensorProxy",
                "net.hadess.SensorProxy", "ReleaseLight", None, None,
                Gio.DBusCallFlags.NONE, -1, None,
            )
        except GLib.Error:
            pass
        self.claimed = False

    def lux(self):
        value = self.bus.call_sync(
            "net.hadess.SensorProxy", "/net/hadess/SensorProxy",
            "org.freedesktop.DBus.Properties", "Get",
            GLib.Variant("(ss)", ("net.hadess.SensorProxy", "LightLevel")),
            None, Gio.DBusCallFlags.NONE, -1, None,
        )
        return value.unpack()[0]


def main():
    sensor = Sensor()

    def shutdown(*_):
        sensor.release()
        sys.exit(0)

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    last_set = None
    paused_until = 0.0

    while True:
        time.sleep(POLL_SECONDS)
        now = time.monotonic()

        current = current_pct()

        # Not where we left it means someone adjusted it by hand. Stand down
        # rather than fight a deliberate choice.
        if current is not None and last_set is not None:
            if abs(current - last_set) > MANUAL_TOLERANCE:
                paused_until = now + MANUAL_PAUSE_SECONDS
                last_set = current

        if now < paused_until:
            continue

        try:
            lux = sensor.lux()
        except GLib.Error:
            # iio-sensor-proxy restarted; re-establish the claim.
            try:
                sensor.claimed = False
                sensor.claim()
            except GLib.Error:
                pass
            continue

        target = lux_to_pct(lux)

        # An unreadable backlight must not mean "write unconditionally": that
        # fires every tick forever, pops the OSD every tick, and permanently
        # disables the manual-override check, which also needs a reading.
        if current is None:
            continue

        if abs(target - current) >= STEP_THRESHOLD:
            set_pct(target)
            last_set = target


if __name__ == "__main__":
    main()
